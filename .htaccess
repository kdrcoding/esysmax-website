# esysmax.com on Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https and no www
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://esysmax.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.esysmax\.com$ [NC]
  RewriteRule ^ https://esysmax.com%{REQUEST_URI} [L,R=301]

  # The repository's tools and page sources are not part of the website.
  RewriteRule ^(src|tools|\.git|\.github)(/|$) - [R=404,L]
  RewriteRule ^(README\.md|DEPLOY\.md)$ - [R=404,L]

  # Clean addresses: /buy serves buy.html, /buy.html goes to /buy.
  RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?] [NC]
  RewriteCond %1 !^index$
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://licence.esysmax.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  # The update feed is always read fresh.
  <FilesMatch "^latest\.json(\.sig)?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/octet-stream .sig
  AddType application/x-msi .msi
</IfModule>
